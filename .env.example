SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=.railway.app,localhost,127.0.0.1
DATABASE_URL=postgresql://user:pass@host:5432/dbname
CORS_ALLOWED_ORIGINS=https://seu-frontend.vercel.app,http://localhost:5173

# E-mail (opcional) — sem isso preenchido, os e-mails só aparecem no
# terminal do runserver (backend "console"), nada é enviado de verdade.
# Exemplo pra Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587,
# EMAIL_HOST_USER=seuemail@gmail.com, EMAIL_HOST_PASSWORD=senha de app
# (não a senha normal da conta — precisa gerar uma "senha de app" no Google).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=EAC MRO <nao-responda@mro.com>
